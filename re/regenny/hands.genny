        Matrix4f localMatrix @ 0x44
        Matrix4f worldMatrix @ 0x84
        bool8 usePreTransform @ 0xc4
        bool8 usePostTransform @ 0xc5
        Matrix4f postTransform @ 0x108
        Node3DPartial* parent @ 0x180
    }
}
